# Copy to .env.local to change behaviour. Nothing here is a secret: Vite exposes every
# VITE_* value to the browser, so never put provider API keys (Gemini, Claude) here.

# Base URL of a DockBrain HTTP API implementing API_CONTRACT.md. Leave empty for demo mode.
VITE_DOCKBRAIN_API_URL=

# Robot model. Leave empty for the DockBrain robot (GLB/dockbrain-companion.glb at the repo root).
# Set a URL such as /models/other.glb for another GLB/GLTF model, or none for the
# built-in robot made from simple shapes.
VITE_ROBOT_GLB_URL=
